{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-runtime:schema:manifest-v1",
  "title": "Decision bundle manifest 1.0",
  "type": "object",
  "required": ["format_version", "artifact_kind", "model_version", "policy_version", "trust", "files", "inference_payload_sha256"],
  "properties": {
    "format_version": {"const": "1.0"},
    "artifact_kind": {"enum": ["sparse_linear", "encoder_onnx"]},
    "model_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "trust": {"enum": ["local_unsigned", "signed_ed25519"]},
    "files": {
      "type": "object",
      "minProperties": 11,
      "propertyNames": {"pattern": "^[A-Za-z0-9_./-]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "inference_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
